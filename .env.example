# Environment template - copy to .env and fill in

# ===== Database =====
DB_URL=jdbc:postgresql://localhost:5432/onecase
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== LLM (Chat - MiniMax) =====
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# ===== Embedding (SiliconFlow - BGE-m3) =====
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=<your-siliconflow-api-key>

# ===== Rerank (Jina) =====
JINA_API_KEY=

# ===== OneCase 自定义 =====
ARTIFACT_STORAGE_DIR=/onecase-artifacts
ONECASE_RECOVERY_MAX_ATTEMPTS=3